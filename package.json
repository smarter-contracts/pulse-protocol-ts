{
  "name": "pulse-protocol-ts",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "docs": "typedoc",
    "clean": "turbo run clean"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": ">=6.4.3",
      "esbuild": ">=0.28.1",
      "markdown-it": ">=14.2.0",
      "postcss": ">=8.5.10",
      "js-yaml": ">=4.2.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.20.1",
    "turbo": "^2.10.7",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  }
}
