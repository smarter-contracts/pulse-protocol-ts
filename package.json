{
  "name": "pulse-protocol-ts",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "docs": "typedoc",
    "clean": "turbo run clean"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": ">=6.4.3",
      "esbuild": ">=0.28.1",
      "markdown-it": "^14.3.1",
      "postcss": ">=8.5.10",
      "js-yaml": ">=5.4.1",
      "source-map-js": ">=1.2.2",
      "brace-expansion": ">=5.0.12"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.20.5",
    "turbo": "^2.11.7",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
